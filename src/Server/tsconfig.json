{
  "compilerOptions": {
    "target": "ES2018",
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "./*.ts"
  ],
  "exclude": [
    "./dist",
    "./data"
  ]
}
